<?xml version="1.0" encoding="utf-8"?>
<!--  res/values-night/themes/themes.xml  -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.IntegrationSDKTest" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_200</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Dark mode = white status icons (on dark toolbar) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Dark bottom nav bar -->
        <item name="android:navigationBarColor">@color/bottom_nav_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>