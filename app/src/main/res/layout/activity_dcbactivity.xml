<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.DCBActivity">

    <Button
        android:id="@+id/btnOpenPlayStore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Google Play" />

    <Button
        android:id="@+id/btnPaymentMethods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Open Payment Methods" />

    <Button
        android:id="@+id/btnCarrierBilling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Open Carrier Billing" />

    <Button
        android:id="@+id/btnDcbPoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DCB POC" />

</LinearLayout>