<?xml version="1.0" encoding="utf-8"?>
<!--
    item_card.xml
    Full-width row card. No icons. Left accent bar + title + chevron.
    All colors are set programmatically via ColorPalette in the adapter.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F0EEFF">

    <!-- cardBackgroundColor is overridden at runtime — this default is just a fallback -->

    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="64dp"
        android:gravity="center_vertical">

        <!-- Left accent bar -->
        <View
            android:id="@+id/cardAccentBar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#5B4FCF"/>

        <!-- Title -->
        <TextView
            android:id="@+id/cardTextView1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- Chevron -->
        <ImageView
            android:id="@+id/cardChevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_chevron_right"
            android:alpha="0.3"
            android:scaleType="center"
            android:contentDescription="open"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>