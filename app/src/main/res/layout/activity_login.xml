<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/activity_login.xml

    FIXES:
    1. Form card uses @color/surface — adapts to dark/light automatically
    2. Input text/hint colors use @color/ refs — dark mode safe
    3. Buttons use CardView wrappers — guaranteed corner radius on all APIs
    4. Push Profile is now an outlined white/surface button — always readable
    5. App icon uses ic_sdk_logo (layers) instead of ic_home
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    android:fitsSystemWindows="false">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- HERO                                                  -->
    <!-- ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/heroContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/toolbar_bg"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- SDK layers icon -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/login_icon_bg"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sdk_logo"
                android:scaleType="centerInside"
                android:contentDescription="SDK icon"/>

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CleverTap Android SDK Integration"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Sign in to your account"
            android:textSize="13sp"
            android:textColor="#99FFFFFF"/>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- SCROLLABLE BODY                                       -->
    <!-- ══════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ── Form card — uses @color/surface (dark mode aware) ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/ProfileInputLayout"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/purple_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/user_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter your name"
                            android:inputType="textPersonName"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mobile Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile Number"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/ProfileInputLayout"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="@color/purple_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mobile_no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="+91 XXXXX XXXXX"
                            android:inputType="phone"
                            android:maxLength="14"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Identity -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Identity"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/ProfileInputLayout"
                        app:startIconDrawable="@drawable/ic_identity"
                        app:startIconTint="@color/purple_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/user_identity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Your unique ID"
                            android:inputType="text"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/ProfileInputLayout"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/purple_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/email_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="you@example.com"
                            android:inputType="textEmailAddress"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/ProfileInputLayout"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/purple_500"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/purple_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/user_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter password"
                            android:inputType="textPassword"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Sign In — CardView wrapper guarantees rounded corners ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/on_user_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign In"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@drawable/toolbar_bg"
                    android:clickable="true"
                    android:focusable="true"/>

            </androidx.cardview.widget.CardView>

            <!-- ── Push Profile — outlined, surface bg, always readable ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface">

                <TextView
                    android:id="@+id/push_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Push Profile"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_500"
                    android:gravity="center"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:background="@drawable/push_profile_btn_bg"
                    android:clickable="true"
                    android:focusable="true"/>

            </androidx.cardview.widget.CardView>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:text="Identity and Email are required to sign in"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>